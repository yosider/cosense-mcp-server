{
  // cf. https://code.visualstudio.com/docs/reference/variables-reference#_input-variables
  "inputs": [
    {
      "description": "Enter your Cosense Project Name",
      "id": "cosense-project-name",
      "type": "promptString"
    },
    {
      "description": "Enter your Cosense SID",
      "id": "cosense-sid",
      "password": true,
      "type": "promptString"
    }
  ],
  "servers": {
    "cosense-mcp-server": {
      "args": [
        "-y",
        "."
      ],
      "command": "npx",
      "dev": {},
      "env": {
        "COSENSE_PROJECT_NAME": "${input:cosense-project-name}",
        "COSENSE_SID": "${input:cosense-sid}"
      },
      "type": "stdio"
    }
  }
}